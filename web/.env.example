# GitHub fine-grained token: Issues (read/write) + Metadata (read) for each repo in kenban.config.json
GITHUB_TOKEN=
# Claude API key used for 「AIで仕様化」「修正指示」
ANTHROPIC_API_KEY=
# Optional model override
KENBAN_MODEL=claude-sonnet-5-5
# Basic auth for the board (required in production)
KENBAN_USER=ken
KENBAN_PASSWORD=
