# --- Google ログイン(Auth.js) ---
# Google Cloud Console → API とサービス → 認証情報 → OAuth クライアント ID(ウェブ)
#   承認済みのリダイレクト URI: https://<あなたのドメイン>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32 。GitHub トークンの暗号化にも使うので、変えると連携し直しになります
AUTH_SECRET=
# 任意: ログインできる Google アカウントを絞る(カンマ区切り)。空なら誰でもログインでき、自分のボードと共有されたボードだけが見えます
KBAN_ALLOWED_EMAILS=

# --- GitHub 連携(OAuth App) ---
# GitHub → Settings → Developer settings → OAuth Apps → New
#   Authorization callback URL: https://<あなたのドメイン>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- 保存先(Upstash Redis。Vercel → Storage → Upstash for Redis で自動設定されます) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI(「AIで進め方を作る」「AIで優先順位」「AIに差し戻す」) ---
ANTHROPIC_API_KEY=
KBAN_MODEL=claude-sonnet-5-5
